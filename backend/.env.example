# EstateIQ Backend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file to version control.

# ──────────────────────────────────────────────────────
# Django Core Settings
# ──────────────────────────────────────────────────────

# A strong, random secret key for Django (do NOT use the default!)
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed host domains in production
# Example: ALLOWED_HOSTS=estateiq.com,www.estateiq.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────

# Leave empty to use SQLite (development default).
# Set to a PostgreSQL URL to switch databases, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/estateiq_db
DATABASE_URL=

# ──────────────────────────────────────────────────────
# ML Microservice Connection
# ──────────────────────────────────────────────────────

# Base URL of the FastAPI XGBoost prediction service
ML_SERVICE_URL=http://localhost:8001

# Timeout (seconds) for ML service calls — defaults to 3s if not set
ML_SERVICE_TIMEOUT=3

# ──────────────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────────────

# Access token lifetime in minutes (default: 60)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
