# EstateIQ Frontend — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.

# ──────────────────────────────────────────────────────
# API Connection
# ──────────────────────────────────────────────────────

# Base URL of the Django REST Framework backend API
# Development default:
VITE_API_BASE_URL=http://localhost:8000/api

# Production example:
# VITE_API_BASE_URL=https://api.estateiq.in/api

# ──────────────────────────────────────────────────────
# ML Microservice (for direct frontend prediction calls, if any)
# ──────────────────────────────────────────────────────

# Base URL of the FastAPI XGBoost prediction service
# Note: In production, route this through a reverse proxy (Nginx/Caddy)
VITE_ML_SERVICE_URL=http://localhost:8001
